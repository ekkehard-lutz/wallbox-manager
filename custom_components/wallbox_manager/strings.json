  "options": {
    "step": {
      "init": {
        "title": "Capability fallback references",
        "description": "Fill only missing capabilities. Verified OCPP values always take precedence. Explicitly associate station, EVSE and connector; individual capability fields are optional. Decimal values and fractions such as 6.5 or 13/2 are accepted. Set normal current limits using the control entities.",
        "data": {
          "reference_station_id": "Station ID",
          "reference_evse_id": "EVSE ID",
          "reference_connector_id": "Connector ID",
          "reference_phases": "Supported phase counts (e.g. 1,3)",
          "reference_modes": "Explicit conductor mappings (e.g. l1;l1,l2,l3)",
          "reference_min_a": "Minimum current (A)",
          "reference_step_a": "Current step (A)",
          "reference_phase_switching": "Phase switching supported",
          "reference_enable_disable": "Enable/disable supported",
          "reference_max_1a": "Maximum current 1p (A)",
          "reference_max_2a": "Maximum current 2p (A)",
          "reference_max_3a": "Maximum current 3p (A)"
        }
      }
    },
