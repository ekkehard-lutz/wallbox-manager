{
  "title": "Wallbox Manager",
  "config": {
    "step": {
      "user": {
        "title": "Wallbox Manager",
        "description": "Host an OCPP endpoint on a trusted local network. Manual control requires explicitly verified capabilities. Configure the wallbox to connect to ws://HA-address:port/station-id.",
        "data": {
          "host": "Local bind address",
          "port": "WebSocket port"
        }
      }
    },
    "abort": {
      "already_configured": "Wallbox Manager is already configured."
    },
    "error": {
      "invalid_listener": "Enter a valid IP address and a port between 1 and 65535."
    }
  },
